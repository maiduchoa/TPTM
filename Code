#include <Servo.h>

const int relayPin = 8; // Chân điều khiển Relay
Servo myservo;

void setup() {
  pinMode(relayPin, OUTPUT);
  
  // Trạng thái ban đầu khi mới bật mạch: TẮT
  digitalWrite(relayPin, LOW); 
  
  myservo.attach(9);            // Khai báo chân tín hiệu Servo nối vào chân số 9
  myservo.write(0);             // Ban đầu cho servo ở góc 0 độ (Trạng thái TẮT)
  
  Serial.begin(9600);           // Mở cổng Serial tốc độ 9600
}

void loop() {
  if (Serial.available() > 0) {
    char command = Serial.read(); // Đọc ký tự lệnh ('1' hoặc '0')
    
    // Nếu Python gửi lệnh '1' (XÒE TAY trước camera -> BẬT)
    if (command == '1') {
      digitalWrite(relayPin, HIGH); // Relay ĐÓNG (Đèn relay sáng)
      myservo.write(180);           // Quay servo đến góc 180 độ
    } 
    // Nếu Python gửi lệnh '0' (NẮM TAY hoặc HẠ TAY -> TẮT)
    else if (command == '0') {
      digitalWrite(relayPin, LOW);  // Relay NGẮT (Đèn relay tắt)
      myservo.write(0);             // Quay servo về lại góc 0 độ
    }
  }
}
